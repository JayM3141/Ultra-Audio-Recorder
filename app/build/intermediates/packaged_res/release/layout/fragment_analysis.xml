<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- View Mode Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_fft_view"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="FFT"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_spectrogram_view"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Spectrogram"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_oscilloscope_view"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Scope"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_3d_view"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="3D"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <!-- Spectrogram View -->
        <com.ultraaudio.recorder.visualization.SpectrogramView
            android:id="@+id/spectrogram_view"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="8dp" />

        <!-- FFT Spectrum -->
        <com.ultraaudio.recorder.visualization.SpectrumView
            android:id="@+id/analysis_spectrum_view"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="8dp" />

        <!-- Oscilloscope -->
        <com.ultraaudio.recorder.visualization.WaveformView
            android:id="@+id/analysis_waveform_view"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginBottom="8dp" />

        <!-- Mic Selector for Array -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@color/card_dark">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mic Source:"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinner_analysis_mic"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@color/surface_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_combined_view"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Combined"
                android:textSize="11sp"
                android:layout_marginStart="4dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
