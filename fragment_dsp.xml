<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- DSP Master Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@color/card_dark"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DSP Processing"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switch_dsp_master"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Parametric EQ Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@color/card_dark"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Parametric EQ"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/spinner_eq_bands"
                    android:layout_width="80dp"
                    android:layout_height="30dp"
                    android:background="@color/surface_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" bands"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/switch_eq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_eq_bands"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Noise Removal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@color/card_dark"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Noise Removal"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_capture_noise"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Capture Profile"
                    android:textSize="10sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <Switch
                    android:id="@+id/switch_noise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView android:layout_width="70dp" android:layout_height="wrap_content"
                    android:text="Threshold" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <SeekBar android:id="@+id/seekbar_noise_threshold"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:max="90" android:progress="40" />
                <TextView android:id="@+id/tv_noise_threshold"
                    android:layout_width="50dp" android:layout_height="wrap_content"
                    android:text="-40dB" android:textColor="@color/accent" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView android:layout_width="70dp" android:layout_height="wrap_content"
                    android:text="Reduction" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <SeekBar android:id="@+id/seekbar_noise_reduction"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:max="60" android:progress="20" />
                <TextView android:id="@+id/tv_noise_reduction"
                    android:layout_width="50dp" android:layout_height="wrap_content"
                    android:text="20dB" android:textColor="@color/accent" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- AGC -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@color/card_dark"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Auto Gain Control"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switch_agc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                    android:text="Target Level" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <SeekBar android:id="@+id/seekbar_agc_target"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:max="48" android:progress="12" />
                <TextView android:id="@+id/tv_agc_target"
                    android:layout_width="50dp" android:layout_height="wrap_content"
                    android:text="-12dB" android:textColor="@color/accent" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Filters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@color/card_dark"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Filters (HP/LP/BP/BS)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="+ Add"
                    android:textSize="10sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <Switch
                    android:id="@+id/switch_filters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Reverb -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@color/card_dark"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reverberance"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switch_reverb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView android:layout_width="70dp" android:layout_height="wrap_content"
                    android:text="Room Size" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <SeekBar android:id="@+id/seekbar_reverb_room"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:max="100" android:progress="50" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView android:layout_width="70dp" android:layout_height="wrap_content"
                    android:text="Wet/Dry" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <SeekBar android:id="@+id/seekbar_reverb_wet"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:max="100" android:progress="30" />
            </LinearLayout>
        </LinearLayout>

        <!-- BSS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@color/card_dark"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Blind Source Separation"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switch_bss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
